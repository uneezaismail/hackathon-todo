{
  "dashboard": {
    "title": "Red Metrics - Service Health",
    "description": "RED (Rate, Errors, Duration) metrics for microservices monitoring",
    "tags": ["monitoring", "services", "red"],
    "timezone": "UTC",
    "panels": [
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (job)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Request Duration (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) by (job)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Request Duration (P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) by (job)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Service Availability",
        "targets": [
          {
            "expr": "(1 - (sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job) / sum(rate(http_requests_total[5m])) by (job))) * 100"
          }
        ],
        "type": "stat"
      }
    ]
  }
}
